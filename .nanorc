include "/usr/share/nano/*.nanorc"

set softwrap
set autoindent
set tabstospaces
# set jumpyscrolling
set newbuffer
set multibuffer
set indicator
set smarthome
set regexp
set afterends
set linenumbers
set tabsize 4
set wordchars "_"
set zap
set atblanks
set nonewlines

set titlecolor bold,white,orange #slate
set promptcolor ,orange #slate
set errorcolor bold,white,red
set spotlightcolor black,lightyellow
set statuscolor bold,white,orange #green
set selectedcolor lightwhite,orange #slate
set scrollercolor orange
set numbercolor orange #cyan
set keycolor orange #cyan
set functioncolor orange #green

## cleanup

unbind M-J                main
unbind ^J                 main
unbind ^V                 main
unbind ^Y                 main
unbind ^X                 main
unbind ^U                 main
unbind M-B                all
unbind M-F                all
unbind M-Space            all
unbind M-\                all
unbind M-T                main
unbind M-H                all
unbind M-I                all
unbind M-K                all
unbind M-L                all
unbind M-O                all
unbind M-M                all
unbind M-S                all
unbind M-Z                all
unbind M-Q                all

unbind ^H main
unbind ^K main
## binds

bind ^Q      exit          all
bind ^Z      undo          main
bind M-R     redo          main
bind M-C     copy          main
bind M-V     paste         main
bind M-X     cut           main
#bind ^K     zap            main
bind M-Del   zap           main
#bind ^H      chopwordleft  main
bind M-/     comment       main
bind ^Space  complete      main
bind M-Left  home          main
bind M-Right end           main
bind M-Up   "{end}{enter}{up}{copy}{paste}{delete}{up}{up}"         main
bind M-Down "{end}{enter}{up}{copy}{paste}{delete}{up}"             main

bind ^C   location      main
bind ^E   wherewas      all
bind M-E  findprevious  all
bind ^R   replace       main
bind ^/   gotoline      main
bind ^G   firstline     all
bind M-G  lastline      all
bind ^B   pageup        all  # vim-like
bind ^F   pagedown      all  # vim-like

bind M-1    help          all
bind M-1    exit          help
bind Sh-M-C constantshow  main
bind Sh-M-F formatter     main
bind Sh-M-B linter        main

###